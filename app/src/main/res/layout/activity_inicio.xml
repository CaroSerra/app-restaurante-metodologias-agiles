<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".InicioActivity">

    <!-- ===== MAPA (provisional) ===== -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/map_background">

        <ImageButton
            android:id="@+id/btnUbicacion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="158dp"
            android:layout_marginTop="200dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_mi_ubicacion"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ubicacion" />

        <ImageButton
            android:id="@+id/btnBandera1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="263dp"
            android:layout_marginTop="198dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_restaurante_mapa"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bandera" />

        <ImageButton
            android:id="@+id/btnBandera2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="80dp"
            android:layout_marginTop="310dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_restaurante_mapa"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bandera" />

        <ImageButton
            android:id="@+id/btnBandera3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="272dp"
            android:layout_marginTop="310dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_restaurante_mapa"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bandera" />
    </FrameLayout>

    <!-- ===== PARTE SUPERIOR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_barra_busqueda"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_buscar"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/inicio_buscar_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/neutral_650"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnPerfil"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_perfil"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_perfil" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="1dp">

            <LinearLayout
                android:id="@+id/btnComparar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/inicio_comparar"
                    android:src="@drawable/ic_comparar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/inicio_favoritos"
                    android:src="@drawable/ic_favoritos" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== PANEL INFERIOR ===== -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        app:behavior_expandedOffset="130dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.4"
        app:behavior_hideable="false"
        app:behavior_peekHeight="48dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Asa (=) -->
        <LinearLayout
            android:id="@+id/handle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_desplegar"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="22dp"
                android:layout_height="2dp"
                android:background="@color/neutral_950" />

            <View
                android:layout_width="22dp"
                android:layout_height="2dp"
                android:layout_marginTop="3dp"
                android:background="@color/neutral_950" />
        </LinearLayout>

        <!-- Cabecera con X (comparar y detalle) -->
        <LinearLayout
            android:id="@+id/llCabeceraComparar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSeleccionados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnCancelarComparar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cerrar"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cerrar" />
        </LinearLayout>

        <!-- Lista de restaurantes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRestaurantes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_restaurante" />

        <!-- Comparación -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svComparacion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_comparacion"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/comparacion1"
                    layout="@layout/item_comparacion"
                    android:layout_width="match_parent"
                    android:layout_height="216dp" />

                <include
                    android:id="@+id/comparacion2"
                    layout="@layout/item_comparacion"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Detalle del restaurante -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svDetalle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/detalleTarjeta"
                    layout="@layout/item_restaurante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabsDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        app:tabIconTint="@color/tab_icon_color"
                        app:tabIndicatorColor="@color/verde_950"
                        app:tabIndicatorFullWidth="true"
                        app:tabInlineLabel="false"
                        app:tabSelectedTextColor="@color/verde_950"
                        app:tabTextColor="@color/neutral_650">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:icon="@drawable/ic_menu"
                            android:text="@string/tab_menu" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:icon="@drawable/ic_resenas"
                            android:text="@string/tab_resenas" />
                    </com.google.android.material.tabs.TabLayout>

                    <!-- Pestaña MENÚ -->
                    <LinearLayout
                        android:id="@+id/llMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="48dp"
                            android:paddingTop="12dp">

                            <TextView
                                android:id="@+id/tvPrecioMin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/neutral_650"
                                android:textSize="12sp" />

                            <com.google.android.material.slider.RangeSlider
                                android:id="@+id/rsPrecio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:stepSize="1"
                                android:valueFrom="1"
                                android:valueTo="100"
                                app:haloColor="@color/verde_450"
                                app:labelBehavior="gone"
                                app:thumbColor="@color/verde_950"
                                app:trackColorActive="@color/verde_950"
                                app:trackColorInactive="@color/neutral_250" />

                            <TextView
                                android:id="@+id/tvPrecioMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/neutral_650"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llPlatosMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@color/verde_350"
                            android:orientation="vertical"
                            android:paddingHorizontal="48dp"
                            android:paddingBottom="12dp" />

                        <TextView
                            android:id="@+id/tvMenuVacio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="@string/menu_vacio"
                            android:textColor="@color/neutral_650"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Pestaña RESEÑAS -->
                    <LinearLayout
                        android:id="@+id/llResenas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/verde_350"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <RatingBar
                                android:id="@+id/rbNuevaResena"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:progressBackgroundTint="@color/neutral_250"
                                android:progressTint="@color/amarillo_950"
                                android:rating="0"
                                android:secondaryProgressTint="@color/amarillo_950"
                                android:stepSize="1" />

                            <TextView
                                android:id="@+id/tvAnadirComentario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="8dp"
                                android:text="@string/resena_anadir"
                                android:textColor="@color/neutral_650"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@color/verde_550" />

                        <LinearLayout
                            android:id="@+id/llListaResenas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Botón Comparar que flota justo encima del panel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCompararFlotante"
        style="@style/Widget.App.Button.Primary"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginBottom="10dp"
        android:text="@string/comparar_button"
        android:visibility="gone"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|center_horizontal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>