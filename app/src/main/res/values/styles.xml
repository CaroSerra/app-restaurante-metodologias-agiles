<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Caja del campo de texto (Figma: Component 2) -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">260dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/field_background</item>
        <item name="boxStrokeColor">@color/field_border</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="endIconTint">@color/text_placeholder</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Texto de dentro del campo -->
    <style name="Widget.App.TextField.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Título verde de pantalla -->
    <style name="TextAppearance.App.ScreenTitle" parent="">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botón principal verde -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/neutral_075</item>
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>